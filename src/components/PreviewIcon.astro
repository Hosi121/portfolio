---
import brandIcons from '../data/preview-brand-icons.json';

interface Props { kind: keyof typeof brandIcons | 'consent' | 'vr' | 'fhe' }
const { kind } = Astro.props;
// Brand paths are stored locally; each source is recorded in preview-brand-icons.json.
const brand = kind in brandIcons ? brandIcons[kind as keyof typeof brandIcons] : null;
---
<span class="bio-preview-icon" data-icon={kind} aria-hidden="true">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
    {brand ? <path d={brand.path} fill={brand.color} /> : <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      {kind === 'consent' ? <>
        <rect x="3" y="4.5" width="18" height="15" rx="3" />
        <path d="M3 9h18M6.5 6.8h.1m2.7 0h.1M9 13c0-1.5 1.3-2 3-2s3 .5 3 2v2c0 1.4-1.2 2.4-3 3-1.8-.6-3-1.6-3-3z" />
        <path d="m10.8 14.5.9.9 1.6-1.9" />
      </> : kind === 'vr' ? <>
        <path d="m4.5 7.5 15-.4c1.4 0 2 1.2 2 3v4c0 1.8-1.1 2.7-2.7 2.7h-3.1l-2.1-2.5h-3.2l-2.1 2.5H5.2c-1.6 0-2.7-.9-2.7-2.7v-4c0-1.8.6-2.6 2-2.6z" />
        <path d="M6.5 11.5h2m7 0h2M7 5h10" />
      </> : <>
        <rect x="5.5" y="10" width="13" height="11" rx="3" />
        <path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10m-3.5 4v3" />
        <circle cx="12" cy="14" r=".6" />
      </>}
    </g>}
  </svg>
</span>
