---
const { slug = '', isNew = false } = Astro.props;
---
<div id="local-editor" data-slug={slug} data-new={String(isNew)}>
  <div class="edit-actions">
    <button type="button" id="start-edit">{isNew ? '記事を書く' : '編集'}</button>
    <button type="button" id="save-post" hidden>保存</button>
    <button type="button" id="finish-edit" hidden>閲覧に戻る</button>
    <span id="live-reading-stats" class="reading-stats" aria-label="編集中の文字数と推定読了時間" aria-live="off" hidden></span>
    <span id="save-status" role="status" aria-live="polite"></span>
  </div>
  <p id="edit-error" role="alert" hidden></p>
  {!isNew && <a id="saved-copy" href={`/blog/${slug}/`} target="_blank" rel="noopener" hidden>保存済みの記事を別タブで開く</a>}
  <div id="edit-options" hidden>
    <details class="article-settings" open={isNew}>
    <summary>記事の設定</summary>
    <div class="post-settings">
      {isNew && <label>URL名<input id="post-slug" required pattern="[a-zA-Z0-9][a-zA-Z0-9_-]*" placeholder="my-first-post" /></label>}
      <label>日付<input id="post-date" type="date" required /></label>
      <label class="draft-choice"><input id="post-draft" type="checkbox" checked />下書き</label>
    </div>
    <label class="description-field">概要<input id="post-description" maxlength="2000" /></label>
    </details>
    <div class="format-tools" role="group" aria-label="本文の書式">
      <button type="button" data-command="heading">見出し</button>
      <button type="button" data-command="bold">太字</button>
      <button type="button" data-command="italic">斜体</button>
      <button type="button" data-command="bulletList">箇条書き</button>
      <button type="button" data-command="blockquote">引用</button>
      <button type="button" data-command="codeBlock">コード</button>
      <button type="button" id="add-footnote">脚注</button>
      <button type="button" id="add-link">リンク</button>
      <button type="button" id="choose-image"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8" cy="8" r="1.5" /><path d="m3 17 6-6 4 4 3-3 5 5" /></svg>画像を追加</button>
      <input type="file" id="post-image" aria-label="追加する画像" accept="image/png,image/jpeg,image/webp,image/gif" hidden />
    </div>
    <div id="link-fields" hidden><label>リンク先<input type="url" id="link-url" placeholder="https://…" /></label><button type="button" id="apply-link">適用</button></div>
  </div>
</div>
<script is:inline type="module" src="/src/editor/client.ts"></script>
<style is:global>
  #local-editor { margin-bottom: 1.5rem; }
  #local-editor [hidden], [data-edit-title][hidden], #inline-body[hidden], #article-body[hidden] { display: none !important; }
  #local-editor button { font: inherit; color: var(--accent); background: transparent; border: 1px solid var(--line); border-radius: 3px; padding: .3rem .65rem; cursor: pointer; }
  #local-editor button:hover, #local-editor button[aria-pressed="true"] { background: #eee9e1; }
  #local-editor button:disabled { opacity: .5; cursor: wait; }
  .edit-actions, .post-settings, .format-tools { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .8rem; }
  .edit-actions { font-size: .75rem; }
  #save-status { color: var(--muted); }
  #edit-error { color: #a03326; }
  .article-settings { margin-block: .75rem; }
  .article-settings summary { cursor: pointer; color: var(--muted); font-size: .75rem; }
  .post-settings { margin-top: 1rem; }
  .post-settings label, .description-field, #link-fields label { font-size: .75rem; color: var(--muted); }
  #local-editor input:not([type="checkbox"]):not([type="file"]) { display: block; max-width: 100%; width: 100%; padding: .3rem 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); font: inherit; }
  .description-field { display: block; margin-block: .8rem; }
  .format-tools { font-size: .75rem; border-block: 1px solid var(--line); padding-block: .7rem; }
  #choose-image { display: inline-flex; align-items: center; gap: .35rem; }
  #link-fields { margin-top: .5rem; }
  [data-edit-title] { display: block; width: 100%; resize: none; field-sizing: content; min-height: 1.6em; margin: .5rem 0 0; padding: 0; color: inherit; font: inherit; font-size: 1.5rem; font-weight: 500; line-height: 1.6; border: 0; background: transparent; }
  .tiptap { min-height: 12rem; outline-offset: .6rem; }
  .tiptap > :first-child { margin-top: 0; }
  .tiptap p.is-editor-empty:first-child::before { content: 'ここから本文を書く'; color: var(--muted); pointer-events: none; }
  @media (max-width: 40rem) { [data-edit-title] { font-size: 1.35rem; } }
</style>
