---
import SiteFooter from '../components/SiteFooter.astro';
import { base } from '../lib/posts';
const { title, description = '片岩拓也のブログ', draft = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <title>{title} | Hosi121</title>
  <meta name="description" content={description} />
  {draft && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="stylesheet" href={`${base}/styles.css`} />
  <link rel="stylesheet" href={`${base}/blog.css`} />
  <link rel="alternate" type="application/rss+xml" title="Hosi121 Blog" href={`${base}/rss.xml`} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="article" /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(`${base}/og-garden.png`, Astro.site)} />
{import.meta.env.DEV && <script is:inline type="module" src="/src/editor/no-reload.ts"></script>}
</head>
<body>
  <a class="skip-link" href="#content">本文へ</a>
  <div class="page">
    <header class="site-header"><a class="site-signature" href={`${base}/`}><span class="site-flower" aria-hidden="true">✳</span> Hosi121</a><nav aria-label="ナビゲーション"><a href={`${base}/blog/`}>Blog</a></nav></header>
    <main id="content" class="blog-main"><slot /></main>
  </div>
  <SiteFooter />
</body>
</html>
