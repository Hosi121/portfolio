---
import { selectedContributions } from '../data/selected-contributions';
import { safetyProjects } from '../data/safety-projects';
import { systemProjects } from '../data/system-projects';
import { creationPrograms } from '../data/creation-programs';
import BrandIcon from './BrandIcon.astro';

interface Props {
  lang: 'ja' | 'en';
  kind: 'creation' | 'systems' | 'speed' | 'safety';
  label: string;
}
const { lang, kind, label } = Astro.props;
const id = `bio-${kind}`;
const titles = {
  creation: { ja: 'ものづくりのプログラム・受賞', en: 'Programs and awards for building new things' },
  systems: { ja: '貢献しているシステム', en: 'Systems I contribute to' },
  speed: { ja: '高速化のPR', en: 'Performance pull requests' },
  safety: { ja: '安全性とプライバシー', en: 'Security & privacy' },
};
const title = titles[kind][lang];
---
<span class="bio-reference" data-hover-preview><button data-preview-trigger class="bio-trigger text-preview-trigger" type="button" popovertarget={id}>{label}</button><span data-preview-panel class="bio-preview" id={id} data-kind={kind} popover="auto" role="region" aria-labelledby={`${id}-title`}>
  <span class="sr-only" id={`${id}-title`}>{title}</span>
  <span class:list={['bio-preview-list', { 'bio-system-grid': kind === 'systems' }]} role="list">
    {kind === 'creation' ? creationPrograms.map(project => <span class="bio-creation-item" role="listitem">
      <span class="bio-creation-links">
        {project.programs.map(program => <a class="bio-icon-link" href={program.href} aria-label={program.name[lang]} title={program.name[lang]}><BrandIcon kind={program.icon} /></a>)}
      </span>
      <span>{project.name[lang]}</span>
    </span>) : kind === 'systems' ? systemProjects.map(project => <span role="listitem">
      <a class="bio-icon-link" href={`https://github.com/${project.repository}`} target="_blank" rel="noopener noreferrer" aria-label={project.name} title={project.name}><BrandIcon kind={project.icon} /></a>
    </span>) : kind === 'safety' ? safetyProjects.map(project => <span class="bio-preview-item" role="listitem">
      <a class="bio-preview-project" href={project.url} target="_blank" rel="noopener noreferrer"><BrandIcon kind={project.icon} />{project.name}</a>
    </span>) : selectedContributions.map(contribution => {
      const url = `https://github.com/${contribution.repository}`;
      return (
        <span class="bio-preview-item" role="listitem">
          <BrandIcon kind={contribution.icon} />
          <span class="bio-preview-links">
            {contribution.pullRequests.map(number => <a href={`${url}/pull/${number}`} target="_blank" rel="noopener noreferrer" aria-label={`${contribution.name} PR #${number}`} title={`${contribution.name} PR #${number}`}>#{number}</a>)}
          </span>
        </span>
      );
    })}
  </span>
</span></span>

<script>
  import '../lib/hover-preview';
</script>
